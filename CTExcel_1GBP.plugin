#!name=CTExcel UK £1 Top-up
#!desc=Changes the CTExcel UK web top-up frontend minimum from £5 to £1. Does not collect or store personal data.
#!author=Sukewarm
#!homepage=https://github.com/Sukewarm/Scriptunlock

[Script]
http-response ^https:\/\/www\.ctexcel\.com\/uk\/js\/chunk\.[^/?]+\.js(?:\?.*)?$ requires-body=1,script-path=https://raw.githubusercontent.com/Sukewarm/Scriptunlock/main/CTExcel_1GBP.js,timeout=10,tag=CTExcel £1 Top-up

[MITM]
hostname = %APPEND% www.ctexcel.com
