#!name=CTExcel UK £1 Top-up
#!desc=Changes the CTExcel UK web top-up frontend minimum from £5 to £1. Does not collect or store personal data.
#!version=1.0.3
#!author=Sukewarm
#!homepage=https://github.com/Sukewarm/Scriptunlock

[Script]
http-response ^https:\/\/www\.ctexcel\.com\/uk\/js\/.*\.js(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Sukewarm/Scriptunlock/main/CTExcel_1GBP.js,timeout=10,requires-body=true,max-size=-1,tag=CTExcel £1 Top-up,enable=true

[MITM]
hostname = www.ctexcel.com
